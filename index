<script>
window.addEventListener('error', function(e) {
  console.error('RunFront error:', e.message || e.error || e);
});
window.addEventListener('unhandledrejection', function(e) {
  console.error('RunFront async error:', e.reason);
});
if(typeof maplibregl==='undefined'||typeof supabase==='undefined'){
  document.body.innerHTML='<main style="min-height:100%;display:grid;place-items:center;padding:28px;background:#090909;color:#fff;font:16px/1.5 system-ui;text-align:center"><section style="max-width:520px"><h2 style="font-size:24px;margin-bottom:12px">RunFront could not start</h2><p style="color:#bbb">A required app library did not load. Check your internet connection, then reopen this page in Chrome. If this keeps happening, the CDN may be blocked or unavailable.</p><p style="margin-top:16px;color:#888;font-size:13px">Missing: '+(typeof maplibregl==='undefined'?'MapLibre ':'')+(typeof supabase==='undefined'?'Supabase':'')+'</p><button onclick="location.reload()" style="margin-top:20px;padding:12px 20px;border-radius:8px;background:#fff;color:#000;font-weight:700">Try again</button></section></main>';
  throw new Error('RunFront dependency failed to load');
}
const $=s=>document.querySelector(s),KM=111320,KY=110540,TC=['','#25F4EE','#3DA5FF','#7B8CFF','#C77DFF','#FF4F9A','#FE2C55','#FF8A00','#FFD60A'],TX=t=>[1,7,8].includes(t)?'#000':'#fff',LB=['','F','D','C','B','A','S','S+','SS'],MI=.621371;
const band=mi=>mi<=2?'Low tier':mi<=8?'Medium tier':'High tier';
const dist=(a,b)=>Math.hypot((b[0]-a[0])*Math.cos(a[1]*Math.PI/180)*KM,(b[1]-a[1])*KY);
let S={loops:[],pts:0,runs:[],tick:Date.now(),me:{name:'runner',bio:''},friends:[],msgs:{}};try{S=Object.assign(S,JSON.parse(localStorage.getItem('rf')))}catch(e){}
const save=()=>{try{localStorage.setItem('rf',JSON.stringify(S))}catch(e){}};
/* Tiers: anything under 8 mi is T1 (T2 only if the terrain is tough). 8+ mi climbs T3-T6. */
/* Tier list: low (F, D) up to 2 mi, medium (C, B, A) over 2 up to 8 mi, high (S, S+, SS) over 8 mi. Tough terrain moves a run up one tier inside its band. */
const tierOf=(km,ter=0)=>{const mi=km*MI;let t=mi<1?1:mi<=2?2:mi<4?3:mi<6?4:mi<=8?5:mi<13.1?6:mi<20?7:8;if(ter>=25)t=Math.min(mi<=2?2:mi<=8?5:8,t+1);return t},rate=t=>[0,1,2,5,12,30,100,250,600][t]||0;
const mi1=km=>(km*MI).toFixed(km*MI<10?2:1),paceMi=spk=>spk?fmtT(spk/MI):'–';
const dLabel=n=>n<25?'Easy':n<45?'Moderate':n<65?'Hard':'Brutal';
function turnsOf(p){const s=[];p.forEach(q=>{if(!s.length||dist(s[s.length-1],q)>=80)s.push(q)});const h=(a,b)=>Math.atan2((b[0]-a[0])*Math.cos(a[1]*Math.PI/180),b[1]-a[1])*180/Math.PI;let n=0;for(let i=2;i<s.length;i++){let d=Math.abs(h(s[i-1],s[i])-h(s[i-2],s[i-1]));if(d>180)d=360-d;if(d>60)n++}return n}
function scoreOf(km,gain,turns){const mi=Math.max(km*MI,.1),dp=Math.min(55,mi*2.1),cp=gain==null?0:Math.min(30,gain/mi/8),tp=Math.min(15,turns/mi*1.5);return{ter:cp+tp,score:Math.round(dp+cp+tp)}}
async function elevGain(p){const n=Math.min(100,p.length),ix=[];for(let i=0;i<n;i++)ix.push(Math.round(i*(p.length-1)/Math.max(1,n-1)));
 const la=ix.map(i=>p[i][1].toFixed(5)).join(','),lo=ix.map(i=>p[i][0].toFixed(5)).join(',');
 const ac=new AbortController(),to=setTimeout(()=>ac.abort(),7000),r=await fetch('https://api.open-meteo.com/v1/elevation?latitude='+la+'&longitude='+lo,{signal:ac.signal});clearTimeout(to);const e=(await r.json()).elevation;if(!e||!e.length)throw 0;
 let ref=e[0],g=0;e.forEach(v=>{if(v-ref>2){g+=v-ref;ref=v}else if(ref-v>2)ref=v});return g*3.28084}
function rescore(d){const o=scoreOf(d.km,d.gain,d.turns);d.score=o.score;d.ter=o.ter;d.tier=tierOf(d.km,o.ter)}
const diffHTML=d=>`<div style="display:flex;justify-content:space-between;margin-bottom:6px"><span>Difficulty</span><span>${d.loading?'Reading terrain…':dLabel(d.score)+' · '+d.score}</span></div><div class="bar2" style="margin:0 0 14px"><u style="width:${d.score}%;background:#fff;transition:width .5s"></u></div>`;
const statsHTML=d=>`<div class="st"><span><b>${d.gain==null?(d.loading?'…':'–'):Math.round(d.gain)+' ft'}</b><small>climb</small></span><span><b>${d.turns}</b><small>turns</small></span><span><b>${rate(d.tier)}</b><small>pts/hr</small></span></div>`;
S.loops.forEach(l=>{l.tier=tierOf(l.km,l.ter||0)});
const fmtT=s=>{s=Math.round(s);return Math.floor(s/60)+':'+String(s%60).padStart(2,'0')};
